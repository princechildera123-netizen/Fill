# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# REVENUECAT PUBLIC API KEYS (NEVER hard-code or expose secret keys)
# 1. Development / Test Store Public Key:
#    Use REVENUECAT_PUBLIC_API_KEY for the RevenueCat Test Store public API key in web/development.
REVENUECAT_PUBLIC_API_KEY="rc_web_placeholder_key"
VITE_REVENUECAT_PUBLIC_API_KEY="rc_web_placeholder_key"

# 2. Android Native Public Key:
#    Use VITE_REVENUECAT_ANDROID_PUBLIC_KEY when running Android native application against Google Play / Android RC config.
VITE_REVENUECAT_ANDROID_PUBLIC_KEY="goog_placeholder_key"

# 3. iOS Native Public Key:
#    Use VITE_REVENUECAT_IOS_PUBLIC_KEY when running iOS native application against App Store / iOS RC config.
VITE_REVENUECAT_IOS_PUBLIC_KEY="appl_placeholder_key"

# SECURITY ENFORCEMENT:
# NEVER put RevenueCat secret REST API keys (sk_...), Supabase service-role keys,
# or private credentials into client code or environment variables.
